# Telegram Bot API token from @BotFather
BOT_TOKEN=1234567890:replace_me

# Bot API chat_id of the support forum supergroup.
# Supergroup/channel IDs in Bot API are negative and normally start with -100.
SUPPORT_GROUP_ID=-1001234567890

# Telegram user IDs allowed to run admin commands, comma-separated.
ADMIN_IDS=12345678,87654321

# Optional: IDs allowed to answer users from forum topics. Defaults to ADMIN_IDS.
OPERATOR_IDS=12345678,87654321

# Optional settings
DATA_FILE=threads_data.json
LOG_LEVEL=INFO
